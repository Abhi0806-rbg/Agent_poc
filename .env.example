# ─────────────────────────────────────────────────────────────────────────────
# Copy this file to .env and fill in your values.
# Never commit .env to source control.
#
# Leave all keys empty to run fully offline using the built-in MockClient.
# MockClient behaviour is intentional when model names resolve to "mock".
# ─────────────────────────────────────────────────────────────────────────────

# --- Provider API keys (never commit) ----------------------------------------
OPENAI_API_KEY=
ANTHROPIC_API_KEY=

# --- Model identifiers --------------------------------------------------------
# fast  : OpenAI chat model used by advisor, content-agent, quiz-coach, supervisor
#         Recommended: gpt-4o-mini
MODEL_FAST=gpt-4o-mini

# smart : Anthropic chat model used by report-agent
#         Recommended: claude-3-5-haiku-20241022
MODEL_SMART=claude-3-5-haiku-20241022

# embed : OpenAI embedding model (must produce 384-dim vectors to match the DB column)
#         Recommended: text-embedding-3-small
MODEL_EMBED=text-embedding-3-small

# --- Optional overrides -------------------------------------------------------
# DB_URL=jdbc:postgresql://localhost:5432/agents
# DB_USER=agents
# DB_PASSWORD=agents
# AGENT_CONFIG_DIR=./config
